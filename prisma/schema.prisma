/// 文件说明：该文件定义企业微信业务增长中台 V1.0 的数据库结构。
/// 功能说明：覆盖多租户、用户角色、线索、标签、跟进、策略库、资料包、表单和企业微信配置预留。
///
/// 结构概览：
///   第一部分：Prisma 生成器与数据源
///   第二部分：业务枚举
///   第三部分：多租户与用户模型
///   第四部分：线索增长闭环模型
///   第五部分：资料、表单和企业微信预留模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  paused
  expired
}

enum TenantPlan {
  flagship
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  OPERATOR
  SALES
}

enum UserStatus {
  active
  disabled
}

enum LeadSource {
  douyin
  xiaohongshu
  shipinhao
  gongzhonghao
  website
  friend_circle
  offline_event
  referral
  imported
  other
}

enum CustomerType {
  OWNER_CLIENT
  DEALER_CLIENT
  DESIGNER_CLIENT
  FACTORY_CLIENT
  CHANNEL_PARTNER
  OLD_CLIENT
  PLATFORM_FACTORY_OWNER
  PLATFORM_MEMBERSHIP_CLIENT
  PLATFORM_GEO_AI_CLIENT
  PLATFORM_TRAINING_CLIENT
  PLATFORM_EVENT_RESOURCE_CLIENT
  PLATFORM_SUPPLY_CHAIN_CLIENT
  PLATFORM_AFTERMARKET_CLIENT
  PLATFORM_PARTNER_CLIENT
  OTHER
}

enum NeedType {
  PRODUCT_INQUIRY
  COOPERATION
  GET_MATERIAL
  ASK_PRICE
  BOOK_CONSULTATION
  AFTER_SALES
  INVESTMENT_JOIN
  GROWTH_SYSTEM
  OTHER
}

enum IntentionLevel {
  LOW
  MEDIUM
  HIGH
  STRONG
}

enum LeadStage {
  NEW
  MATERIAL_SENT
  CONTACTED
  DIAGNOSED
  QUOTED
  PENDING_DEAL
  DEAL_DONE
  LOST
  TO_REACTIVATE
}

enum DealStatus {
  NONE
  PENDING
  WON
  LOST
}

enum TagGroup {
  SOURCE
  CUSTOMER_TYPE
  NEED
  INTENTION
  STAGE
  BUSINESS_LINE
  IMPORTED
  CUSTOM
}

enum FormType {
  material_request
  diagnosis
  booking
  event_signup
  cnas_path_check
}

enum MaterialType {
  pdf
  image
  video
  link
  document
}

enum WeComConfigStatus {
  draft
  enabled
  disabled
}

enum FollowTaskType {
  FIRST_FOLLOW
  SEND_MATERIAL
  PHONE_CALL
  WECHAT_FOLLOW
  QUOTE_FOLLOW
  REACTIVATE
  VISIT_INVITE
  DEAL_PUSH
  CUSTOM
}

enum FollowTaskStatus {
  PENDING
  DONE
  DELAYED
  CANCELLED
}

enum FollowTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReminderChannel {
  IN_APP
  WECOM_APP
  EMAIL
  SMS
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ReplySuggestionStyle {
  DIRECT
  WARM
  PROFESSIONAL
}

enum BusinessLineStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BusinessLineCategory {
  SERVICE
  PRODUCT
  ACTIVITY
  COURSE
  SUPPLY_CHAIN
  MEMBERSHIP
  PARTNERSHIP
  OTHER
}

enum ImportBatchStatus {
  PENDING
  PREVIEWED
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  FAILED
  DUPLICATE
  SKIPPED
}

enum CommunicationComplianceChannel {
  WECHAT_ARCHIVE
  PHONE_RECORDING
  ASR_TRANSCRIPTION
}

enum CommunicationComplianceStatus {
  DISABLED
  APPLYING
  ENABLED
  PAUSED
  ARCHIVED
}

enum CommunicationComplianceProvider {
  MANUAL
  WECHAT_ARCHIVE_PLACEHOLDER
  PHONE_SYSTEM_PLACEHOLDER
  ASR_PROVIDER_PLACEHOLDER
  OTHER
}

enum MarketClawKnowledgeType {
  SERVICE_INTRO
  FAQ
  STANDARD_REPLY
  CASE_STUDY
  PRICE_BOUNDARY
  DELIVERY_PROCESS
  OBJECTION_HANDLING
  FORBIDDEN_COMMITMENT
  RISK_NOTICE
  SALES_SCRIPT
  OTHER
}

enum MarketClawKnowledgeStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MarketClawKnowledgeScopeLevel {
  ENTERPRISE
  DEPARTMENT
  BUSINESS_LINE
  PERSONAL
  PLATFORM_TEMPLATE
}

enum MarketClawKnowledgeVisibility {
  PRIVATE
  DEPARTMENT
  TENANT
}

enum MarketClawKnowledgeReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  ARCHIVED
}

enum MarketClawTrainingRating {
  GOOD
  NEEDS_EDIT
  BAD
  UNRATED
}

enum MarketClawTrainingReviewStatus {
  DRAFT
  GENERATED
  PERSONAL_SAVED
  PENDING_REVIEW
  TEAM_APPROVED
  ENTERPRISE_APPROVED
  REJECTED
  DISMISSED
}

enum MarketClawTrainingScope {
  ENTERPRISE_TRAINING
  DEPARTMENT_TRAINING
  BUSINESS_LINE_TRAINING
  SALES_SELF_TRAINING
}

enum MarketClawReplyUseStatus {
  GENERATED
  COPIED
  SAVED_AS_FOLLOWUP
  DISMISSED
}

enum MarketClawReplySourceScope {
  CUSTOMER_REPLY
  TRAINING
  PERSONAL_LIBRARY
}

enum MarketClawFeedbackStatus {
  USEFUL
  NOT_USEFUL
  NEEDS_EDIT
  UNRATED
}

enum MarketClawReviewResult {
  NONE
  ADOPT_AS_PERSONAL
  ADOPT_AS_TEAM
  ADOPT_AS_ENTERPRISE
  REJECTED
}

enum MarketClawIngestionSourceType {
  PASTED_TEXT
  TXT
  MARKDOWN
  CSV
  MANUAL
}

enum MarketClawIngestionStatus {
  DRAFT
  PROCESSING
  CANDIDATES_GENERATED
  REVIEWING
  COMPLETED
  FAILED
}

enum MarketClawKnowledgeCandidateReviewStatus {
  PENDING_REVIEW
  ADOPTED
  ADOPTED_WITH_EDIT
  REJECTED
  MERGED
}

model Tenant {
  id          String                 @id @default(cuid())
  name        String
  slug        String                 @unique
  industry    String?
  status      TenantStatus           @default(active)
  plan        TenantPlan             @default(flagship)
  startedAt   DateTime               @default(now())
  expiredAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  users       User[]
  leads       Lead[]
  leadTags    LeadTag[]
  followUps   FollowUp[]
  strategies  CustomerTypeStrategy[]
  materials   Material[]
  intakeForms IntakeForm[]
  weComConfig WeComConfig?
  auditLogs   AuditLog[]
  followTasks FollowTask[]
  taskTemplates TaskTemplate[]
  reminderQueues ReminderQueue[]
  replySuggestions ReplySuggestion[]
  businessLines BusinessLine[]
  importBatches  ImportBatch[]
  importRows     ImportRow[]
  communicationComplianceConfigs CommunicationComplianceConfig[]
  leadSourceAttributions         LeadSourceAttribution[]
  marketClawKnowledgeItems       MarketClawKnowledgeItem[]
  marketClawTrainingCases        MarketClawTrainingCase[]
  marketClawReplyDrafts          MarketClawReplyDraft[]
  marketClawReplyFeedbacks       MarketClawReplyFeedback[]
  marketClawIngestionBatches     MarketClawIngestionBatch[]
  marketClawKnowledgeCandidates  MarketClawKnowledgeCandidate[]
}

model User {
  id           String      @id @default(cuid())
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id])
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus  @default(active)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  ownedLeads   Lead[]      @relation("LeadOwner")
  followUps    FollowUp[]
  sessions     Session[]
  auditLogs    AuditLog[]
  ownedTasks   FollowTask[] @relation("TaskOwner")
  createdTasks FollowTask[] @relation("TaskCreator")
  reminderQueues ReminderQueue[]
  replySuggestions ReplySuggestion[]
  importBatches  ImportBatch[]
  confirmedCommunicationComplianceConfigs CommunicationComplianceConfig[] @relation("CommunicationComplianceConfirmedBy")
  sourceAttributedLeads                 LeadSourceAttribution[]          @relation("LeadSourceAttributionStaff")
  createdMarketClawKnowledgeItems       MarketClawKnowledgeItem[]        @relation("MarketClawKnowledgeCreator")
  updatedMarketClawKnowledgeItems       MarketClawKnowledgeItem[]        @relation("MarketClawKnowledgeUpdater")
  createdMarketClawTrainingCases        MarketClawTrainingCase[]         @relation("MarketClawTrainingCreator")
  createdMarketClawReplyDrafts          MarketClawReplyDraft[]           @relation("MarketClawReplyDraftCreator")
  marketClawReplyFeedbacks              MarketClawReplyFeedback[]
  createdMarketClawIngestionBatches     MarketClawIngestionBatch[]       @relation("MarketClawIngestionBatchCreator")
  createdMarketClawKnowledgeCandidates  MarketClawKnowledgeCandidate[]   @relation("MarketClawKnowledgeCandidateCreator")

  @@index([tenantId, role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  name           String
  phone          String
  wechat         String?
  company        String?
  industry       String?
  city           String?
  source         LeadSource      @default(other)
  customerType   CustomerType    @default(OTHER)
  needType       NeedType        @default(OTHER)
  intentionLevel IntentionLevel  @default(MEDIUM)
  stage          LeadStage       @default(NEW)
  message        String?
  extraData      Json?
  ownerId        String?
  owner          User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  nextFollowAt   DateTime?
  lastFollowAt   DateTime?
  dealStatus     DealStatus      @default(NONE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tags           LeadTag[]
  followUps      FollowUp[]
  intakeForms    IntakeForm[]
  followTasks    FollowTask[]
  reminderQueues ReminderQueue[]
  replySuggestions ReplySuggestion[]
  importRows        ImportRow[]
  sourceAttribution LeadSourceAttribution?
  marketClawReplyDrafts   MarketClawReplyDraft[]
  marketClawReplyFeedbacks MarketClawReplyFeedback[]

  @@index([tenantId, createdAt])
  @@index([tenantId, source])
  @@index([tenantId, customerType])
  @@index([tenantId, stage])
}

model LeadTag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  tagName   String
  tagGroup  TagGroup @default(CUSTOM)
  createdAt DateTime @default(now())

  @@index([tenantId, leadId])
}

model FollowUp {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  leadId       String
  lead         Lead       @relation(fields: [leadId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  marketClawReplyDraftId String?
  marketClawReplyDraft   MarketClawReplyDraft? @relation("MarketClawReplyDraftFollowUps", fields: [marketClawReplyDraftId], references: [id])
  content      String
  nextAction   String?
  nextFollowAt DateTime?
  stageBefore  LeadStage?
  stageAfter   LeadStage?
  createdAt    DateTime   @default(now())

  @@index([tenantId, leadId, createdAt])
}

model ReplySuggestion {
  id                     String               @id @default(cuid())
  tenantId               String
  tenant                 Tenant               @relation(fields: [tenantId], references: [id])
  leadId                 String
  lead                   Lead                 @relation(fields: [leadId], references: [id])
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id])
  customerQuestion       String
  suggestionText         String
  recommendedMaterialIds Json?
  suggestedTags          Json?
  recommendedNextAction  String
  style                  ReplySuggestionStyle
  warning                String
  createdAt              DateTime             @default(now())

  @@index([tenantId, leadId, userId, createdAt])
  @@index([tenantId, createdAt])
}

model CustomerTypeStrategy {
  id                        String       @id @default(cuid())
  tenantId                  String
  tenant                    Tenant       @relation(fields: [tenantId], references: [id])
  customerType              CustomerType
  name                      String
  painPoints                String[]
  firstMaterials            String[]
  welcomeScript             String
  day3Script                String
  day7Script                String
  day15Script               String
  manualTriggerRules        String[]
  recommendedNextAction     String
  recommendedPrivateContent String
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([tenantId, customerType])
}

model Material {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  title        String
  description  String?
  type         MaterialType  @default(link)
  url          String
  customerType CustomerType?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId, customerType])
}

model BusinessLine {
  id                         String               @id @default(cuid())
  tenantId                   String
  tenant                     Tenant               @relation(fields: [tenantId], references: [id])
  name                       String
  slug                       String
  description                String?
  status                     BusinessLineStatus   @default(ACTIVE)
  category                   BusinessLineCategory @default(OTHER)
  priority                   Int                  @default(100)
  targetCustomerTypes        Json?
  recommendedTagNames        Json?
  recommendedMaterialIds     Json?
  recommendedTaskTemplateIds Json?
  defaultNextAction          String?
  notes                      String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  marketClawKnowledgeItems   MarketClawKnowledgeItem[]
  marketClawTrainingCases    MarketClawTrainingCase[]
  marketClawReplyDrafts      MarketClawReplyDraft[]
  marketClawIngestionBatches MarketClawIngestionBatch[]
  marketClawKnowledgeCandidates MarketClawKnowledgeCandidate[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, priority])
}

model ImportBatch {
  id                     String            @id @default(cuid())
  tenantId               String
  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  createdById            String
  createdBy              User              @relation(fields: [createdById], references: [id])
  fileName               String
  fileType               String
  status                 ImportBatchStatus @default(PENDING)
  totalRows              Int               @default(0)
  successRows            Int               @default(0)
  failedRows             Int               @default(0)
  duplicateRows          Int               @default(0)
  skippedRows            Int               @default(0)
  generatedTaskRows      Int               @default(0)
  mapping                Json?
  defaultOwnerId         String?
  defaultTags            Json?
  defaultBusinessLineIds Json?
  autoCreateFirstTask    Boolean           @default(false)
  skipDuplicates         Boolean           @default(true)
  errorSummary           Json?
  completedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  rows                   ImportRow[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
}

model ImportRow {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  batchId         String
  batch           ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex        Int
  rawData         Json
  normalizedData  Json?
  status          ImportRowStatus @default(PENDING)
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])
  errorMessage    String?
  duplicateLeadId String?
  createdAt       DateTime        @default(now())

  @@index([tenantId, batchId, rowIndex])
  @@index([tenantId, status, createdAt])
}

model IntakeForm {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  formType      FormType
  source        LeadSource    @default(other)
  name          String
  phone         String
  wechat        String?
  company       String?
  industry      String?
  city          String?
  customerType  CustomerType  @default(OTHER)
  needType      NeedType      @default(OTHER)
  message       String?
  extraData     Json?
  createdLeadId String?
  createdLead   Lead?         @relation(fields: [createdLeadId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
}

model WeComConfig {
  id              String            @id @default(cuid())
  tenantId        String            @unique
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  corpId          String?
  agentId         String?
  secretEncrypted String?
  token           String?
  encodingAESKey  String?
  callbackUrl     String?
  status          WeComConfigStatus @default(draft)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CommunicationComplianceConfig {
  id              String                            @id @default(cuid())
  tenantId        String
  tenant          Tenant                            @relation(fields: [tenantId], references: [id])
  channel         CommunicationComplianceChannel
  status          CommunicationComplianceStatus     @default(DISABLED)
  provider        CommunicationComplianceProvider   @default(MANUAL)
  scopeConfig     Json?
  noticeConfig    Json?
  retentionConfig Json?
  aiConfig        Json?
  confirmedById   String?
  confirmedBy     User?                             @relation("CommunicationComplianceConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt     DateTime?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([tenantId, channel])
  @@index([tenantId, status, updatedAt])
}

model LeadSourceAttribution {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  leadId           String   @unique
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sourceChannel    String?
  sourceProject    String?
  sourceCampaign   String?
  sourceScene      String?
  sourceTouchpoint String?
  sourceQrCode     String?
  sourceStaffName  String?
  sourceStaffId    String?
  sourceStaff      User?    @relation("LeadSourceAttributionStaff", fields: [sourceStaffId], references: [id])
  sourcePage       String?
  sourceContent    String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  firstSeenAt      DateTime?
  submittedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, sourceChannel, createdAt])
  @@index([tenantId, sourceProject, createdAt])
  @@index([tenantId, sourceCampaign, createdAt])
  @@index([tenantId, sourceScene, createdAt])
  @@index([tenantId, sourceStaffId, createdAt])
}

model MarketClawKnowledgeItem {
  id                      String                   @id @default(cuid())
  tenantId                String
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  businessLineId          String?
  businessLine            BusinessLine?            @relation(fields: [businessLineId], references: [id])
  sourceIngestionBatchId  String?
  sourceIngestionBatch    MarketClawIngestionBatch? @relation(fields: [sourceIngestionBatchId], references: [id])
  createdById             String
  createdBy               User                     @relation("MarketClawKnowledgeCreator", fields: [createdById], references: [id])
  updatedById             String
  updatedBy               User                     @relation("MarketClawKnowledgeUpdater", fields: [updatedById], references: [id])
  ownerUserId             String?
  departmentName          String?
  title                   String
  content                 String
  knowledgeType           MarketClawKnowledgeType
  scopeLevel              MarketClawKnowledgeScopeLevel  @default(BUSINESS_LINE)
  visibility              MarketClawKnowledgeVisibility  @default(TENANT)
  reviewStatus            MarketClawKnowledgeReviewStatus @default(APPROVED)
  approvedById            String?
  approvedAt              DateTime?
  sourceTrainingCaseId    String?
  sourceKnowledgeCandidateId String?
  sourceCandidateIds      Json?
  sourceBatchIds          Json?
  lastMergedAt            DateTime?
  lastMergedById          String?
  status                  MarketClawKnowledgeStatus @default(ACTIVE)
  keywords                Json?
  applicableCustomerTypes Json?
  applicableStages        Json?
  recommendedMaterialIds  Json?
  forbiddenPhrases        Json?
  riskNotes               String?
  sortOrder               Int                      @default(100)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  promotedFromTrainingCases MarketClawTrainingCase[]

  @@index([tenantId, businessLineId, knowledgeType, status])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, scopeLevel, reviewStatus, updatedAt])
  @@index([tenantId, departmentName, reviewStatus, updatedAt])
  @@index([tenantId, ownerUserId, reviewStatus, updatedAt])
  @@index([tenantId, sourceIngestionBatchId, updatedAt])
  @@index([tenantId, sourceKnowledgeCandidateId, updatedAt])
}

model MarketClawTrainingCase {
  id                    String                       @id @default(cuid())
  tenantId              String
  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  businessLineId        String?
  businessLine          BusinessLine?                @relation(fields: [businessLineId], references: [id])
  createdById           String
  createdBy             User                         @relation("MarketClawTrainingCreator", fields: [createdById], references: [id])
  ownerUserId           String?
  departmentName        String?
  trainingScope         MarketClawTrainingScope     @default(BUSINESS_LINE_TRAINING)
  customerQuestion      String
  customerType          CustomerType?
  customerStage         LeadStage?
  customerTags          Json?
  replyStyle            String?
  replyLength           String?
  generatedShortReply   String?
  generatedProfessionalReply String?
  generatedClosingReply String?
  manualOptimizedReply  String?
  salesNote             String?
  rating                MarketClawTrainingRating    @default(UNRATED)
  reviewStatus          MarketClawTrainingReviewStatus @default(DRAFT)
  submittedForReviewAt  DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  reviewComment         String?
  forbiddenNotes        String?
  promotedKnowledgeItemId String?
  promotedKnowledgeItem MarketClawKnowledgeItem?    @relation(fields: [promotedKnowledgeItemId], references: [id])
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  replyDrafts           MarketClawReplyDraft[]

  @@index([tenantId, businessLineId, createdAt])
  @@index([tenantId, createdById, createdAt])
  @@index([tenantId, ownerUserId, reviewStatus, updatedAt])
  @@index([tenantId, departmentName, reviewStatus, updatedAt])
  @@index([tenantId, trainingScope, reviewStatus, updatedAt])
}

model MarketClawReplyDraft {
  id                 String                    @id @default(cuid())
  tenantId           String
  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  leadId             String
  lead               Lead                      @relation(fields: [leadId], references: [id])
  businessLineId     String?
  businessLine       BusinessLine?             @relation(fields: [businessLineId], references: [id])
  createdById        String
  createdBy          User                      @relation("MarketClawReplyDraftCreator", fields: [createdById], references: [id])
  departmentName     String?
  trainingCaseId     String?
  trainingCase       MarketClawTrainingCase?   @relation(fields: [trainingCaseId], references: [id], onDelete: SetNull)
  sourceScope        MarketClawReplySourceScope @default(CUSTOMER_REPLY)
  customerQuestion   String
  matchedKnowledgeIds Json?
  usedPersonalKnowledgeIds Json?
  usedDepartmentKnowledgeIds Json?
  usedEnterpriseKnowledgeIds Json?
  shortReply         String?
  professionalReply  String?
  closingReply       String?
  riskWarnings       Json?
  suggestedTags      Json?
  suggestedMaterials Json?
  suggestedTask      Json?
  selectedReplyType  String?
  finalReply         String?
  submittedForReviewAt DateTime?
  useStatus          MarketClawReplyUseStatus   @default(GENERATED)
  feedbackStatus     MarketClawFeedbackStatus   @default(UNRATED)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  followUps          FollowUp[]                 @relation("MarketClawReplyDraftFollowUps")
  feedbacks          MarketClawReplyFeedback[]

  @@index([tenantId, leadId, createdById, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, departmentName, sourceScope, createdAt])
  @@index([tenantId, trainingCaseId, createdAt])
}

model MarketClawReplyFeedback {
  id                     String                  @id @default(cuid())
  tenantId               String
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  replyDraftId           String
  replyDraft             MarketClawReplyDraft    @relation(fields: [replyDraftId], references: [id], onDelete: Cascade)
  leadId                 String
  lead                   Lead                    @relation(fields: [leadId], references: [id])
  createdById            String
  createdBy              User                    @relation(fields: [createdById], references: [id])
  departmentName         String?
  feedbackStatus         MarketClawFeedbackStatus
  feedbackNote           String?
  salesEditedReply       String?
  recommendAsTrainingCase Boolean                @default(false)
  submittedToReview      Boolean                 @default(false)
  reviewedById           String?
  reviewedAt             DateTime?
  reviewResult           MarketClawReviewResult  @default(NONE)
  reviewComment          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([tenantId, replyDraftId, createdAt])
  @@index([tenantId, createdById, createdAt])
  @@index([tenantId, reviewResult, createdAt])
}

model MarketClawIngestionBatch {
  id             String                    @id @default(cuid())
  tenantId       String
  tenant         Tenant                    @relation(fields: [tenantId], references: [id])
  businessLineId String?
  businessLine   BusinessLine?             @relation(fields: [businessLineId], references: [id])
  createdById    String
  createdBy      User                      @relation("MarketClawIngestionBatchCreator", fields: [createdById], references: [id])
  title          String
  sourceType     MarketClawIngestionSourceType
  sourceName     String?
  rawText        String
  status         MarketClawIngestionStatus @default(DRAFT)
  candidateCount Int                       @default(0)
  adoptedCount   Int                       @default(0)
  rejectedCount  Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  candidates     MarketClawKnowledgeCandidate[]
  adoptedKnowledgeItems MarketClawKnowledgeItem[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, businessLineId, createdAt])
  @@index([tenantId, createdById, createdAt])
}

model MarketClawKnowledgeCandidate {
  id                         String                                 @id @default(cuid())
  tenantId                   String
  tenant                     Tenant                                 @relation(fields: [tenantId], references: [id])
  batchId                    String
  batch                      MarketClawIngestionBatch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  businessLineId             String?
  businessLine               BusinessLine?                          @relation(fields: [businessLineId], references: [id])
  createdById                String
  createdBy                  User                                   @relation("MarketClawKnowledgeCandidateCreator", fields: [createdById], references: [id])
  title                      String
  content                    String
  knowledgeType              MarketClawKnowledgeType
  suggestedScopeLevel        MarketClawKnowledgeScopeLevel          @default(BUSINESS_LINE)
  suggestedKeywords          Json?
  suggestedForbiddenPhrases  Json?
  suggestedRiskNotes         String?
  suggestedReplyShort        String?
  suggestedReplyProfessional String?
  suggestedReplyClosing      String?
  similarKnowledgeItemIds    Json?
  similarityHints            Json?
  reviewStatus               MarketClawKnowledgeCandidateReviewStatus @default(PENDING_REVIEW)
  reviewComment              String?
  adoptedKnowledgeItemId     String?
  mergeTargetKnowledgeItemId String?
  mergeAction                String?
  mergeReason                String?
  mergedAt                   DateTime?
  mergedById                 String?
  createdAt                  DateTime                               @default(now())
  updatedAt                  DateTime                               @updatedAt

  @@index([tenantId, batchId, reviewStatus, createdAt])
  @@index([tenantId, businessLineId, reviewStatus, createdAt])
  @@index([tenantId, createdById, reviewStatus, createdAt])
  @@index([tenantId, adoptedKnowledgeItemId, updatedAt])
  @@index([tenantId, mergeTargetKnowledgeItemId, updatedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model FollowTask {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  leadId      String?
  lead        Lead?              @relation(fields: [leadId], references: [id])
  ownerId     String?
  owner       User?              @relation("TaskOwner", fields: [ownerId], references: [id])
  createdById String?
  createdBy   User?              @relation("TaskCreator", fields: [createdById], references: [id])
  title       String
  description String?
  type        FollowTaskType     @default(CUSTOM)
  status      FollowTaskStatus   @default(PENDING)
  priority    FollowTaskPriority @default(NORMAL)
  dueAt       DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  reminderQueues ReminderQueue[]

  @@index([tenantId, status, dueAt])
  @@index([tenantId, ownerId, status, dueAt])
  @@index([tenantId, leadId])
}

model TaskTemplate {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  name           String
  type           FollowTaskType     @default(CUSTOM)
  title          String
  description    String?
  priority       FollowTaskPriority @default(NORMAL)
  defaultDueDays Int                @default(1)
  customerType   CustomerType?
  stage          LeadStage?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId, isActive])
  @@index([tenantId, customerType, stage])
}

model ReminderQueue {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  taskId       String?
  task         FollowTask?     @relation(fields: [taskId], references: [id])
  leadId       String?
  lead         Lead?           @relation(fields: [leadId], references: [id])
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  channel      ReminderChannel @default(IN_APP)
  status       ReminderStatus  @default(PENDING)
  scheduledAt  DateTime
  sentAt       DateTime?
  failedAt     DateTime?
  retryCount   Int             @default(0)
  payload      Json?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, userId, status])
  @@index([taskId, status])
}
